PORT=3000
NODE_ENV=development

# PostgreSQL (Aiven: Console > serviço > Overview > Connection information)
DB_HOST=localhost
DB_PORT=5432
# Banco usado pela aplicação (será criado por npm run db:setup)
DB_NAME=avalia_tcc
# Usuário de trabalho da aplicação (será criado por npm run db:setup)
DB_USER=avalia
DB_PASS=avalia123

# Conta administrativa do Aiven (usada só pelo db:setup; normalmente avnadmin / defaultdb)
PG_ADMIN_USER=postgres
PG_ADMIN_DB=postgres

# SSL (obrigatório no Aiven)
DB_SSL=false
# Caminho do certificado CA baixado do Aiven (ca.pem). Se vazio, o certificado do servidor não é validado.
DB_SSL_CA=./certs/ca.pem

# Segurança (gere um segredo longo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-este-segredo
SESSAO_MINUTOS=30

# Usuário admin nativo (criado automaticamente na primeira execução)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@cps.sp.gov.br
ADMIN_SENHA=Admin@12345

# Atualização do dashboard (segundos)
REFRESH_PUBLICO_SEG=180
REFRESH_ADMIN_SEG=120
