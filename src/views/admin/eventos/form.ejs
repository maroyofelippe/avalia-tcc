<h1 class="h4 mb-3"><%= titulo %></h1>
<% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
<% if (!unidades.length) { %><div class="alert alert-warning">Cadastre uma <a href="/admin/unidades/novo">unidade</a> antes de criar o evento.</div><% } %>
<div class="card"><div class="card-body">
  <form method="post" action="/admin/eventos<%= evento.id ? '/' + evento.id : '' %>">
    <div class="row g-3">
      <div class="col-12 col-md-8">
        <label class="form-label" for="nome">Nome do evento</label>
        <input class="form-control" id="nome" name="nome" maxlength="160" value="<%= evento.nome || '' %>" placeholder="Feira de TCC 2026" required>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label" for="ano">Ano</label>
        <input class="form-control" type="number" id="ano" name="ano" min="2000" max="2100" value="<%= evento.ano || '' %>" required>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label" for="data_evento">Data</label>
        <input class="form-control" type="date" id="data_evento" name="data_evento" value="<%= evento.dataEvento || '' %>">
      </div>
      <div class="col-12 col-md-8">
        <label class="form-label" for="unidade_id">Unidade</label>
        <select class="form-select" id="unidade_id" name="unidade_id" required>
          <option value="">Selecione…</option>
          <% unidades.forEach(function (u) { %>
            <option value="<%= u.id %>" <%= Number(evento.unidadeId) === u.id ? 'selected' : '' %>><%= u.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-4 d-flex align-items-end">
        <div class="form-check"><input class="form-check-input" type="checkbox" id="ativo" name="ativo" value="1" <%= evento.ativo ? 'checked' : '' %>><label class="form-check-label" for="ativo">Evento ativo (visível ao público)</label></div>
      </div>
    </div>
    <div class="mt-4 d-flex gap-2">
      <button class="btn btn-danger">Salvar</button>
      <a class="btn btn-outline-secondary" href="/admin/eventos">Cancelar</a>
    </div>
  </form>
</div></div>
