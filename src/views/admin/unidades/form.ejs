<h1 class="h4 mb-3"><%= titulo %></h1>
<% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
<div class="card"><div class="card-body">
  <form method="post" enctype="multipart/form-data" action="/admin/unidades<%= unidade.id ? '/' + unidade.id : '' %>">
    <div class="row g-3">
      <div class="col-12 col-md-8">
        <label class="form-label" for="nome">Nome da unidade</label>
        <input class="form-control" id="nome" name="nome" maxlength="150" value="<%= unidade.nome || '' %>" placeholder="ETEC …" required>
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label" for="codigo">Código</label>
        <input class="form-control" id="codigo" name="codigo" maxlength="20" value="<%= unidade.codigo || '' %>">
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label" for="cidade">Cidade</label>
        <input class="form-control" id="cidade" name="cidade" maxlength="100" value="<%= unidade.cidade || '' %>">
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label" for="logo">Logo da unidade (PNG, JPG ou WEBP, até 2 MB)</label>
        <input class="form-control" type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/webp">
        <% if (unidade.logo) { %>
          <div class="d-flex align-items-center gap-3 mt-2">
            <img class="logo-unidade" src="<%= unidade.logo %>" alt="Logo atual">
            <div class="form-check"><input class="form-check-input" type="checkbox" id="remover" name="remover_logo" value="1"><label class="form-check-label" for="remover">Remover logo</label></div>
          </div>
        <% } %>
      </div>
    </div>
    <div class="mt-4 d-flex gap-2">
      <button class="btn btn-danger">Salvar</button>
      <a class="btn btn-outline-secondary" href="/admin/unidades">Cancelar</a>
    </div>
  </form>
</div></div>
