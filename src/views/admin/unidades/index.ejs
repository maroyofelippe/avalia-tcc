<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Unidades (ETEC)</h1>
  <a class="btn btn-danger" href="/admin/unidades/novo">Nova unidade</a>
</div>
<div class="card"><div class="table-responsive">
  <table class="table mb-0">
    <thead><tr><th>Logo</th><th>Nome</th><th>Código</th><th>Cidade</th><th></th></tr></thead>
    <tbody>
      <% unidades.forEach(function (u) { %>
        <tr>
          <td><% if (u.logo) { %><img class="logo-mini" src="<%= u.logo %>" alt=""><% } %></td>
          <td><%= u.nome %></td><td><%= u.codigo || '' %></td><td><%= u.cidade || '' %></td>
          <td class="text-end text-nowrap">
            <a class="btn btn-sm btn-outline-secondary" href="/admin/unidades/<%= u.id %>/editar">Editar</a>
            <form class="d-inline" method="post" action="/admin/unidades/<%= u.id %>/excluir" data-confirm="Excluir a unidade <%= u.nome %>?">
              <button class="btn btn-sm btn-outline-danger">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!unidades.length) { %><tr><td colspan="5" class="text-muted">Nenhuma unidade cadastrada.</td></tr><% } %>
    </tbody>
  </table>
</div></div>
