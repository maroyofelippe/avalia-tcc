<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Usuários e sessões</h1>
  <span class="small text-muted">Sessões expiram após <%= sessaoMinutos %> min sem atividade</span>
</div>
<div class="card"><div class="table-responsive">
  <table class="table mb-0" id="tbl-usuarios">
    <thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Cadastro</th><th>Online</th><th>Tempo logado</th><th></th></tr></thead>
    <tbody>
      <% usuarios.forEach(function (u) { %>
        <tr data-id="<%= u.id %>">
          <td><%= u.nome %><% if (u.nativo) { %> <span class="badge text-bg-dark">nativo</span><% } %></td>
          <td><%= u.email %></td>
          <td>
            <% if (u.nativo || u.id === usuario.id) { %>
              <span class="badge text-bg-light"><%= u.perfil %></span>
            <% } else { %>
              <form method="post" action="/admin/usuarios/<%= u.id %>/perfil" class="d-flex gap-1 m-0">
                <select class="form-select form-select-sm" name="perfil" aria-label="Perfil">
                  <option value="gestor" <%= u.perfil === 'gestor' ? 'selected' : '' %>>gestor</option>
                  <option value="admin" <%= u.perfil === 'admin' ? 'selected' : '' %>>admin</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary">OK</button>
              </form>
            <% } %>
          </td>
          <td><span class="badge text-bg-<%= u.ativo ? 'success' : 'warning' %>"><%= u.ativo ? 'Ativo' : 'Pendente/inativo' %></span></td>
          <td data-col="online"><span class="badge text-bg-<%= u.online ? 'success' : 'secondary' %>"><%= u.online ? '● Online' : 'Offline' %></span></td>
          <td data-col="tempo" data-base="<%= u.segundosLogado %>" data-online="<%= u.online ? '1' : '0' %>"><%= u.online ? '' : '—' %></td>
          <td class="text-end text-nowrap">
            <% if (!u.nativo && u.id !== usuario.id) { %>
              <form class="d-inline" method="post" action="/admin/usuarios/<%= u.id %>/ativo">
                <button class="btn btn-sm btn-outline-<%= u.ativo ? 'warning' : 'success' %>"><%= u.ativo ? 'Desativar' : 'Aprovar' %></button>
              </form>
              <form class="d-inline" method="post" action="/admin/usuarios/<%= u.id %>/derrubar" data-confirm="Encerrar as sessões deste usuário?">
                <button class="btn btn-sm btn-outline-danger">Derrubar sessão</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div></div>
<script src="/js/usuarios.js"></script>
