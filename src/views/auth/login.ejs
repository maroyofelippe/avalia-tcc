<div class="row justify-content-center">
  <div class="col-12 col-sm-8 col-md-6 col-lg-4">
    <div class="card">
      <div class="card-body p-4">
        <h1 class="h4 mb-3">Entrar</h1>
        <% if (erro) { %><div class="alert alert-danger py-2"><%= erro %></div><% } %>
        <form method="post" action="/login" autocomplete="on">
          <div class="mb-3">
            <label class="form-label" for="email">E-mail institucional</label>
            <input class="form-control" type="email" id="email" name="email" value="<%= email %>" placeholder="nome@cps.sp.gov.br" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label" for="senha">Senha</label>
            <input class="form-control" type="password" id="senha" name="senha" required>
          </div>
          <button class="btn btn-danger w-100">Entrar</button>
        </form>
        <div class="text-center mt-3 small"><a href="/registro">Cadastrar-me</a></div>
      </div>
    </div>
  </div>
</div>
