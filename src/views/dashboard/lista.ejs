<h1 class="h4 mb-3">Resultados</h1>
<% if (!eventos.length) { %><div class="alert alert-info">Nenhum evento disponível.</div><% } %>
<div class="list-group">
  <% eventos.forEach(function (e) { %>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="/dashboard/<%= e.id %>">
      <% if (e.Unidade && e.Unidade.logo) { %><img class="logo-mini" src="<%= e.Unidade.logo %>" alt=""><% } %>
      <div><strong><%= e.nome %></strong><div class="small text-muted"><%= e.Unidade.nome %> · <%= e.ano %></div></div>
    </a>
  <% }) %>
</div>
