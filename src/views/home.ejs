<div class="text-center my-4">
  <h1 class="h2">Avaliação de TCC</h1>
  <p class="text-muted">Dê sua nota para os trabalhos expostos e acompanhe o resultado em tempo real.</p>
</div>

<% if (!eventos.length) { %>
  <div class="alert alert-info">Nenhum evento disponível no momento.</div>
<% } %>

<div class="row g-3">
  <% eventos.forEach(function (e) { %>
    <div class="col-12 col-md-6">
      <div class="card h-100">
        <div class="card-body d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <% if (e.Unidade && e.Unidade.logo) { %><img class="logo-unidade" src="<%= e.Unidade.logo %>" alt=""><% } %>
            <div>
              <h2 class="h5 mb-0"><%= e.nome %></h2>
              <div class="text-muted small"><%= e.Unidade.nome %> · <%= e.ano %></div>
            </div>
          </div>
          <div class="mt-auto d-flex gap-2">
            <% if (e.votacaoAberta) { %>
              <a class="btn btn-danger flex-fill" href="/votar/<%= e.id %>">Votar</a>
            <% } else { %>
              <button class="btn btn-secondary flex-fill" disabled>Votação encerrada</button>
            <% } %>
            <a class="btn btn-outline-dark flex-fill" href="/dashboard/<%= e.id %>">Resultados</a>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>
