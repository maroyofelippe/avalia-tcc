<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · AvaliaTCC</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body data-logado="<%= usuario ? '1' : '0' %>" data-sessao-min="<%= sessaoMinutos %>">
  <nav class="navbar navbar-expand-lg navbar-dark bg-cps">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="/">AvaliaTCC</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/votar">Votar</a></li>
          <li class="nav-item"><a class="nav-link" href="/dashboard">Resultados</a></li>
          <% if (usuario) { %>
            <li class="nav-item"><a class="nav-link" href="/admin">Painel</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/unidades">Unidades</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/eventos">Eventos</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/questoes">Questões</a></li>
            <% if (usuario.perfil === 'admin') { %>
              <li class="nav-item"><a class="nav-link" href="/admin/usuarios">Usuários</a></li>
            <% } %>
          <% } %>
        </ul>
        <div class="d-flex align-items-center gap-2 text-white">
          <% if (usuario) { %>
            <span class="small"><%= usuario.nome %> <span class="badge text-bg-light"><%= usuario.perfil %></span></span>
            <form method="post" action="/logout" class="m-0"><button class="btn btn-sm btn-outline-light">Sair</button></form>
          <% } else { %>
            <a class="btn btn-sm btn-outline-light" href="/login">Entrar</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <% if (usuario) { %>
    <div id="aviso-sessao" class="alert alert-warning shadow position-fixed bottom-0 end-0 m-3 d-none" role="alert" style="z-index:1080;max-width:340px">
      Sua sessão expira por inatividade em <strong id="aviso-contagem"></strong>.
      <button type="button" id="aviso-continuar" class="btn btn-sm btn-dark ms-2">Continuar conectado</button>
    </div>
  <% } %>

  <main class="container py-4">
    <% if (flash) { %>
      <% const cls = { sucesso: 'success', erro: 'danger', aviso: 'warning' }[flash.tipo] || 'info'; %>
      <div class="alert alert-<%= cls %> alert-dismissible fade show" role="alert">
        <%= flash.mensagem %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% } %>
    <%- body %>
  </main>

  <footer class="text-center text-muted small py-4">AvaliaTCC · Centro Paula Souza</footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <%- script %>
</body>
</html>
