<div class="d-flex align-items-center gap-3 mb-3">
  <% if (evento.Unidade && evento.Unidade.logo) { %>
    <img class="logo-unidade" src="<%= evento.Unidade.logo %>" alt="Logo <%= evento.Unidade.nome %>">
  <% } %>
  <div>
    <h1 class="h4 mb-0"><%= evento.nome %></h1>
    <div class="text-muted small"><%= evento.Unidade ? evento.Unidade.nome : '' %> · <%= evento.ano %></div>
  </div>
</div>
