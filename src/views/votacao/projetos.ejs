<%- include('../partials/evento-cabecalho', { evento }) %>
<p class="text-muted">Olá, <strong><%= votante.alias %></strong>! Escolha um trabalho para avaliar (<%= jaAvaliou.size %> de <%= projetos.length %> avaliados).</p>

<% if (!projetos.length) { %><div class="alert alert-info">Nenhum projeto cadastrado neste evento.</div><% } %>

<div class="row g-3">
  <% projetos.forEach(function (p) { %>
    <div class="col-12 col-md-6">
      <div class="card h-100">
        <div class="card-body d-flex flex-column">
          <h2 class="h6"><%= p.titulo %></h2>
          <div class="small text-muted mb-2"><%= p.curso || '' %> <%= p.curso ? '·' : '' %> Turma <%= p.turma %> · <%= p.ano %></div>
          <% if (p.equipe) { %><div class="small mb-3" style="white-space:pre-line"><%= p.equipe %></div><% } %>
          <div class="mt-auto">
            <% if (jaAvaliou.has(p.id)) { %>
              <button class="btn btn-success w-100" disabled>✓ Avaliado</button>
            <% } else { %>
              <a class="btn btn-danger w-100" href="/votar/<%= evento.id %>/projetos/<%= p.id %>">Avaliar</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>
